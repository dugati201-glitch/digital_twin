[Unit]
Description=Digital Twin Camera WebRTC Service
After=network.target

[Service]
Type=simple
# Create this service account and install the repository at /opt/digital_twin.
User=digital-twin
Group=digital-twin
SupplementaryGroups=video
WorkingDirectory=/opt/digital_twin/services/camera
Environment=LOG_CONFIG_FILE=/etc/digital-twin/logging.yaml
Environment=CAMERA_CONFIG_FILE=/etc/digital-twin/camera.yaml
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/digital_twin/services/camera/.venv/bin/digital-twin-camera
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
